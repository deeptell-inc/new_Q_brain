# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# LaTeX build products (the committed PDFs are the deliverables)
*.aux
*.log
*.out
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*Notes.bib

# OS
.DS_Store
simulation_results/panel_before_regen/

# supplementary.aux is an EXCEPTION to *.aux above: it is a tracked test input.
# test_cross_document_refs.py reads the table numbers LaTeX assigned from it and
# fails hard if it is absent, so a clone without it cannot pass the suite.
!manuscript/supplementary.aux

# superseded figure PDFs, moved aside when \graphicspath was found not to
# override current-directory resolution. Kept locally for reference only.
manuscript/.stale_backup/

# bibtex output; main.tex ships a thebibliography block, so this is a build product
*.bbl

# derivable from scripts/make_bundle.sh; a committed copy only goes stale
manuscript/submission/
manuscript/pccp_submission.tar.gz

# regenerated by scripts/sync_diff.sh from withdrawn/ and the live sources
manuscript/*_diff.tex
manuscript/*_diff.pdf
manuscript/response_to_referees.pdf
