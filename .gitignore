# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# LaTeX build products (the committed PDFs are the deliverables)
*.aux
*.log
*.out
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*Notes.bib

# OS
.DS_Store
simulation_results/panel_before_regen/

# The manuscript itself is not distributed: the repository carries code, results
# and figures, and the LaTeX sources, PDFs, cover letter, response and process
# logs go to the journal. Tests that read them skip on a clone (see
# qbscreen/tests/_manuscript.py). manuscript/figures/ and the make_*.py that
# draw them are results and stay tracked.
manuscript/*.tex
manuscript/*.pdf
# ...except the compiled manuscript, ESI and DAS, which are results
!manuscript/main.pdf
!manuscript/supplementary.pdf
!manuscript/data_availability.pdf
!manuscript/main_diff.pdf
!manuscript/supplementary_diff.pdf
manuscript/*.md
manuscript/*.bib
manuscript/toc_entry.*
manuscript/head_foot/
manuscript/withdrawn/

# superseded figure PDFs, moved aside when \graphicspath was found not to
# override current-directory resolution. Kept locally for reference only.
manuscript/.stale_backup/

# bibtex output; main.tex ships a thebibliography block, so this is a build product
*.bbl

# derivable from scripts/make_bundle.sh; a committed copy only goes stale
manuscript/submission/
manuscript/pccp_submission.tar.gz

# regenerated by scripts/sync_diff.sh from withdrawn/ and the live sources
manuscript/*_diff.tex
# the marked-up copies against the withdrawn submission are distributed
# (regenerated by sync_diff.sh; committed as results, not frozen)
manuscript/response_to_referees.pdf

# the manuscript's own private history (see scripts/mgit.sh)
.manuscript.git/
